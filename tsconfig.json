{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true, "noEmit": true, "skipLibCheck": true, "resolveJsonModule": true, "isolatedModules": true,
    "noUnusedLocals": false, "types": ["vite/client", "node"]
  },
  "include": ["src", "tools", "tests", "vite.config.ts"]
}
